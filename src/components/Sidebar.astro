---
// Sidebar latérale droite — colonne éditoriale épurée :
// Catégories + Articles récents (les liens sponsor/partenaires ont été retirés).
import { getCategories, getPosts, getPostLang, decodeEntities } from '../lib/wp.mjs';

const categories = getCategories()
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 20);

// getPosts() est DÉJÀ trié par date décroissante (wp.mjs)
const recent = getPosts().slice(0, 6);
---

<aside class="sidebar" aria-label="Colonne latérale">
  <div class="side-block">
    <h2 class="side-title">Catégories</h2>
    <ul class="side-links">
      {categories.map((c) => (
        <li><a href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a></li>
      ))}
    </ul>
  </div>

  <div class="side-block">
    <h2 class="side-title">Articles récents</h2>
    <ul class="side-recent">
      {recent.map((p) => (
        <li data-lang={getPostLang(p)}>
          <a href={`/${p.slug}/`}>{decodeEntities(p.title?.rendered ?? '')}</a>
          <time datetime={p.date}>{new Date(p.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style is:global>
  .layout-ws { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 36px; align-items: start; }
  .sidebar { position: sticky; top: 64px; display: flex; flex-direction: column; gap: 26px; }
  .side-block { background: #f7f7f7; border: 1px solid #e2e2e2; border-radius: 8px; padding: 18px 20px; }
  .side-title { font-size: 15px; font-weight: 800; letter-spacing: 0.4px; text-transform: uppercase; color: var(--accent, #4db2ec); margin: 0 0 12px; padding-bottom: 8px; border-bottom: 2px solid var(--accent, #4db2ec); }
  .side-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .side-links a { color: #333; text-decoration: none; font-size: 14.5px; line-height: 1.35; }
  .side-links a:hover { color: var(--accent, #4db2ec); text-decoration: underline; }
  .side-recent { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .side-recent a { color: #222; text-decoration: none; font-size: 14.5px; font-weight: 600; line-height: 1.35; }
  .side-recent a:hover { color: var(--accent, #4db2ec); text-decoration: underline; }
  .side-recent time { display: block; font-size: 12.5px; color: #777; margin-top: 2px; }
  @media (max-width: 980px) {
    .layout-ws { grid-template-columns: 1fr; }
    .sidebar { position: static; }
  }
</style>
