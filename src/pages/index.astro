---
// Accueil — design Newsmag Scandal : articles récents avec photo en haut,
// puis 20 rubriques × 10 articles (= 200 articles max).
// Le H1 et le <title> restent identiques à l'audit (contrat SEO).
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, getPages, PAGE_SIZE, getCategories, getImageMeta, getPostCategories, getPostAuthor, getPostLang, getCategoryLang, getReadingTime, decodeEntities } from '../lib/wp.mjs';
import { getSeoForUrl } from '../lib/seo.mjs';

const posts = getPosts();
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const site = String(Astro.site ?? 'https://prim.net').replace(/\/$/, '');

// Titre et description réels depuis l'audit (contrat SEO) — fallback propre
const homeSeo = getSeoForUrl(site + '/');
const TITLE = homeSeo?.title ?? "Prim.net - L'actualités au quotidien en PRIM";
const DESC = homeSeo?.description ?? "L'actualités au quotidien en PRIM";

// ---- Composition éditoriale ----
// Bloc « À la une » : les 10 articles les plus récents (avec photo) en haut
const une = posts.slice(0, 10);
const [hero, ...recents] = une;
// N'exclure des rubriques que les articles réellement affichés (hero + 6 récents) :
// les posts 8-10 du top 10 restent présents sur la home via leur rubrique (contrat SEO).
const shown = [hero, ...recents.slice(0, 6)];
const usedSlugs = new Set(shown.map((p) => p.slug));

// Rubriques : 20 catégories les plus fournies, 10 articles chacune (200 max)
const rubriques = getCategories()
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 20)
  .map((c) => {
    const list = posts
      .filter((p) => !usedSlugs.has(p.slug) && getPostCategories(p).some((pc) => pc.id === c.id))
      .slice(0, 10);
    list.forEach((p) => usedSlugs.add(p.slug));
    return {
      slug: c.slug,
      name: decodeEntities(c.name),
      count: c.count,
      lang: getCategoryLang(c),
      posts: list,
    };
  })
  .filter((r) => r.posts.length > 0);

const heroImg = getImageMeta(hero, 'large');
const heroCat = getPostCategories(hero)[0];
const heroAuthor = getPostAuthor(hero);
const heroLang = getPostLang(hero);
const heroExcerpt = decodeEntities((hero.excerpt?.rendered ?? '').replace(/<[^>]+>/g, ' ')).replace(/\s+/g, ' ').trim().replace(/…$/, '');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Prim.net',
    url: site + '/',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: site + '/?s={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<Base title={TITLE} description={DESC} canonical={site + '/'} jsonLd={jsonLd} relNext="/page/2/" preloadImage={heroImg.src || undefined}>
  <h1 class="sr-only">Prim.net</h1>

  <!-- À LA UNE : les articles les plus récents avec photo en haut -->
  <section class="hero" aria-label="À la une" data-lang-group data-lang={heroLang}>
    <div class="hero-grid">
      <div class="hero-main" data-lang={heroLang}>
        <a href={`/${hero.slug}/`} class="hero-img-wrap">
          {heroImg.src && (
            <img
              class="hero-img"
              src={heroImg.src}
              srcset={heroImg.srcset || undefined}
              sizes={heroImg.srcset ? '(max-width: 767px) 100vw, 640px' : undefined}
              alt={heroImg.alt || decodeEntities(hero.title?.rendered ?? '')}
              width={heroImg.width ?? undefined}
              height={heroImg.height ?? undefined}
              fetchpriority="high"
            />
          )}
        </a>
        <div class="hero-body">
          <p class="hero-label">À la une</p>
          {heroCat && <span class="badge">{heroCat.name}</span>}
          <h2 class="hero-title"><a href={`/${hero.slug}/`}>{decodeEntities(hero.title?.rendered ?? '')}</a></h2>
          {heroExcerpt && <p class="hero-excerpt">{heroExcerpt}</p>}
          <div class="meta">
            <time datetime={hero.date}>{new Date(hero.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            <span class="sep">·</span>
            <span>par {heroAuthor}</span>
            <span class="sep">·</span>
            <span>{getReadingTime(hero)} min de lecture</span>
          </div>
        </div>
      </div>

      <div class="hero-recents">
        {recents.slice(0, 6).map((p) => (
          <article class="recent-item" data-lang={getPostLang(p)}>
            <a href={`/${p.slug}/`} tabindex="-1" aria-hidden="true">
              {getImageMeta(p, 'medium_large').src && (
                <img
                  class="recent-thumb"
                  src={getImageMeta(p, 'medium_large').src}
                  alt=""
                  decoding="async"
                />
              )}
            </a>
            <div>
              <h3 class="recent-title"><a href={`/${p.slug}/`}>{decodeEntities(p.title?.rendered ?? '')}</a></h3>
              <time class="recent-date" datetime={p.date}>{new Date(p.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- RUBRIQUES : 20 catégories × 10 articles -->
  {rubriques.map((r) => (
    <section class="section-block" id={`rubrique-${r.slug}`} aria-label={r.name} data-lang-group data-lang={r.lang}>
      <div class="section-head">
        <h2 class="section-title">{r.name}</h2>
        <span class="section-link">{r.count} articles</span>
      </div>
      <div class="rubric-grid">
        {r.posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  ))}

  <nav class="pagination" aria-label="Pagination">
    <span class="page-info">Page 1 sur {totalPages}</span>
    <a rel="next" href="/page/2/">Plus d'actualités →</a>
  </nav>
</Base>
