---
// Page Contact — formulaire multistep général
// Sujet « Publication sponsorisée » → encart avec lien vers /publier-un-article/
// (la commande avec paiement se fait sur la page dédiée)
import Base from '../../layouts/Base.astro';
import GeneralContactForm from '../../components/GeneralContactForm.astro';

const TITLE = 'Contact - Prim.net';
const DESC = "Contacter Prim.net : question, partenariat, presse ou demande d'information. Réponse sous 24-48 h. Pour commander une publication sponsorisée, rendez-vous sur notre page dédiée.";
const CANONICAL = 'https://prim.net/contact/';
---

<Base title={TITLE} description={DESC} canonical={CANONICAL}>
  <header class="entry-header">
    <h1 class="entry-title">Contact</h1>
  </header>

  <section class="contact-grid" aria-label="Nous contacter">
    <div class="col-form">
      <GeneralContactForm />
    </div>

    <div class="col-details">
      <p class="contact-kicker">Nous contacter</p>
      <h2 class="contact-title">Écrivez-nous</h2>
      <p>
        Une question sur nos articles, un partenariat, une demande de presse ?
        Remplissez le formulaire en quelques étapes : nous revenons vers vous
        sous 24–48&nbsp;h.
      </p>

      <h3 class="roi-title">Coordonnées</h3>
      <ul class="coord-list">
        <li><strong>✉️ E-mail</strong><span><a href="mailto:contact@prim.net">contact@prim.net</a></span></li>
        <li><strong>🕘 Disponibilité</strong><span>Lun–Ven, 9&nbsp;h – 18&nbsp;h</span></li>
        <li><strong>⚡ Délai de réponse</strong><span>Sous 24–48&nbsp;h ouvrées</span></li>
      </ul>

      <div class="sponso-block">
        <h3 class="roi-title">📰 Vous souhaitez être publié ?</h3>
        <p>
          Commandez votre article sponsorisé sur notre page dédiée : packs,
          durée de publication, options et paiement sécurisé en quelques minutes.
        </p>
        <a class="btn-publier" href="/publier-un-article/">Publier un article →</a>
      </div>

      <h3 class="roi-title">Nos engagements</h3>
      <ul class="roi-list">
        <li><strong>🔒 Confidentialité.</strong> Vos coordonnées ne sont jamais transmises à des tiers ni utilisées à des fins commerciales.</li>
        <li><strong>⚡ Réactivité.</strong> Chaque message reçoit une réponse personnelle sous 24–48&nbsp;h.</li>
        <li><strong>🤝 Transparence.</strong> Les contenus sponsorisés sont clairement identifiés comme tels sur le site.</li>
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* Grille 50/50 : formulaire à gauche (desktop) ; mobile : formulaire en premier */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    max-width: var(--maxw);
    margin: 0 auto 44px;
  }

  .col-form { order: 1; min-width: 0; }
  .col-details { order: 2; min-width: 0; }

  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
    .col-form { order: 0; }
    .col-details { order: 0; }
  }

  /* ---- Détails « Écrivez-nous » ---- */
  .contact-kicker { text-transform: uppercase; font-size: 12px; font-weight: 700; letter-spacing: .12em; color: var(--accent); margin: 0 0 8px; }
  .contact-title { font-size: 26px; margin: 0 0 14px; }
  .col-details p { font-size: 15px; line-height: 1.65; color: #222; }
  .roi-title { font-size: 15px; font-weight: 800; margin: 22px 0 10px; text-transform: uppercase; letter-spacing: .05em; }
  .coord-list { list-style: none; margin: 0; padding: 0; border: 1px solid #c8c8c8; border-radius: 8px; overflow: hidden; }
  .coord-list li { display: flex; justify-content: space-between; gap: 12px; font-size: 13.5px; line-height: 1.5; padding: 9px 14px; border-top: 1px solid #e4e4e4; color: #262626; }
  .coord-list li:first-child { border-top: 0; }
  .coord-list li strong { font-weight: 700; }
  .coord-list a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .coord-list a:hover { text-decoration: underline; }

  /* ---- Encart « être publié » ---- */
  .sponso-block {
    margin-top: 22px; padding: 18px 20px;
    background: #f7f7f7; border: 1px solid #d5d5d5; border-left: 4px solid var(--accent);
    border-radius: 10px;
  }
  .sponso-block .roi-title { margin-top: 0; }
  .sponso-block p { font-size: 14px; }
  .btn-publier {
    display: inline-block; margin-top: 6px; padding: 11px 20px; font-size: 14px; font-weight: 800;
    color: #fff; background: var(--accent); border-radius: 6px; text-decoration: none;
    transition: background 0.15s;
  }
  .btn-publier:hover { background: var(--accent-dark); }

  .roi-list { list-style: none; margin: 0; padding: 0; }
  .roi-list li { font-size: 13.5px; line-height: 1.6; padding: 10px 0; border-top: 1px solid #c8c8c8; color: #262626; }
  .roi-list li strong { display: block; margin-bottom: 2px; }
</style>
