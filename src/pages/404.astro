---
import Base from '../layouts/Base.astro';
const site = String(Astro.site ?? 'https://prim.net').replace(/\/$/, '');
---

<Base title="Page introuvable - Prim.net" description="Cette page n'existe pas." noindex={true}>
  <section class="notfound">
    <h1 class="page-title">404 — Page introuvable</h1>
    <p>La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <p><a href="/">← Retour à l'accueil</a></p>
  </section>
</Base>
