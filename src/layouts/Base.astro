---
// Layout de base — head SEO complet (title, description, canonical, og, JSON-LD)
// Design Newsmag Scandal : topbar date + social + langue + recherche,
// logo centré (image d'origine), navigation sticky, footer optimisé.
import { decodeEntities, getCategories, LANGS } from '../lib/wp.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
  relPrev?: string;
  relNext?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  type = 'website',
  relPrev,
  relNext,
} = Astro.props;

// Préversion : NOINDEX=1 au build => toutes les pages en noindex
const noindexAll = typeof process !== 'undefined' && process.env.NOINDEX === '1';

const GA4_ID = (import.meta.env.PUBLIC_GA4_ID ?? '').trim();

const site = String(Astro.site ?? 'https://prim.net').replace(/\/$/, '');
const pageUrl = canonical ?? site + '/';
const ogType = type === 'article' ? 'article' : 'website';

// Rubriques de la navigation : 20 catégories les plus fournies
const topCats = getCategories()
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 20);

// Réseaux sociaux d'origine du site prim.net
const socials = [
  { name: 'Facebook', url: 'https://www.facebook.com/PrimNetFr', icon: 'facebook' },
  { name: 'X (Twitter)', url: 'https://twitter.com/Prim_fr', icon: 'x' },
  { name: 'Instagram', url: 'https://instagram.com/prim_france', icon: 'instagram' },
];

const today = new Date().toLocaleDateString('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/prim-logo-square.png" />
    <title>{decodeEntities(title)}</title>
    {description && <meta name="description" content={decodeEntities(description)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noindexAll && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />
    {relPrev && <link rel="prev" href={relPrev} />}
    {relNext && <link rel="next" href={relNext} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Prim.net" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={decodeEntities(title)} />
    {description && <meta property="og:description" content={decodeEntities(description)} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="sitemap" href={site + '/sitemap-index.xml'} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    {/* Google Analytics 4 — actif uniquement si PUBLIC_GA4_ID est défini au build */}
    {
      GA4_ID && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
          <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('consent', 'default', {
  ad_storage: 'denied', ad_user_data: 'denied',
  ad_personalization: 'denied', analytics_storage: 'denied',
});
gtag('config', '${GA4_ID}', { anonymize_ip: true });`}></script>
        </>
      )
    }
  </head>
  <body>
    <!-- Bandeau supérieur : date + tagline | langue + réseaux sociaux + recherche -->
    <div class="topbar">
      <div class="container topbar-inner">
        <span class="topbar-date">{today}</span>
        <span class="topbar-tagline">L'actualités au quotidien en PRIM</span>
        <div class="topbar-right">
          <div class="lang-select-wrap">
            <select class="lang-select" id="lang-select" aria-label="Langue">
              <option value="all">🌐 Toutes les langues</option>
              {LANGS.map((l) => <option value={l.code}>{l.label}</option>)}
            </select>
          </div>
          <div class="social-icons">
            {socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.name}>
                {s.icon === 'facebook' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 9H16l.5-3h-3V4.5c0-.9.3-1.5 1.6-1.5H16.6V.2C16.3.2 15.3 0 14.1 0 11.6 0 10 1.5 10 4.2V6H7.5v3H10v11h3.5V9z"/></svg>}
                {s.icon === 'x' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.2h3.3l-7.3 8.3 8.6 11.3h-6.7l-5.3-6.9-6 6.9H2.2l7.8-8.9L1.6 1.2h6.9l4.8 6.3 5.6-6.3zm-1.2 17.6h1.8L7.1 3.1H5.1l12.6 15.7z"/></svg>}
                {s.icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1zm0 2.4c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.2.8-.4.4-.6.7-.8 1.2-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2.4.4.7.6 1.2.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8.4-.4.6-.7.8-1.2.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2-.4-.4-.7-.6-1.2-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 4.1a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6zm0 8.7a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8zm6.6-8.9a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>}
              </a>
            ))}
          </div>
          <button class="search-toggle" id="search-toggle" type="button" aria-expanded="false" aria-controls="search-bar" aria-label="Rechercher">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 2a8 8 0 1 0 4.9 14.3L20 21l1-1-5-5.1A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Barre de recherche (révélée au clic) -->
    <div class="search-bar" id="search-bar">
      <div class="search-bar-inner">
        <form action="/" method="get" role="search" id="search-form">
          <input type="search" name="s" id="search-input" placeholder="Rechercher un article, un sujet…" aria-label="Rechercher" />
          <button type="submit">Rechercher</button>
        </form>
      </div>
    </div>

    <!-- En-tête : logo d'origine centré -->
    <header class="site-header">
      <div class="header-brand">
        <div class="container header-brand-inner">
          <a class="logo" href="/">
            <img class="logo-img" src="/prim-logo.png" alt="Prim.net" width="203" height="75" fetchpriority="high" />
          </a>
          <p class="header-tagline">L'actualités au quotidien en PRIM</p>
        </div>
      </div>
    </header>

    <nav class="header-nav" id="nav-menu" aria-label="Rubriques">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Ouvrir le menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <div class="container nav-inner">
        <a href="/">Accueil</a>
        <div class="nav-drop">
          <button class="nav-drop-btn" type="button" aria-expanded="false" aria-haspopup="true">
            Rubriques <span class="nav-drop-caret" aria-hidden="true">▾</span>
          </button>
          <div class="nav-drop-menu" role="menu">
            {topCats.map((c) => (
              <a role="menuitem" href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
            ))}
          </div>
        </div>
        <a href="/contact/">Contact</a>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <div class="container footer-top-inner">
          <a class="footer-logo" href="/">
            <img class="logo-img footer-logo-img" src="/prim-logo-square.png" alt="Prim.net" width="44" height="44" loading="lazy" />
            <span class="logo-word">Prim<span class="dot">.</span>net</span>
          </a>
          <div class="footer-social">
            {socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.name}>
                {s.icon === 'facebook' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 9H16l.5-3h-3V4.5c0-.9.3-1.5 1.6-1.5H16.6V.2C16.3.2 15.3 0 14.1 0 11.6 0 10 1.5 10 4.2V6H7.5v3H10v11h3.5V9z"/></svg>}
                {s.icon === 'x' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.2h3.3l-7.3 8.3 8.6 11.3h-6.7l-5.3-6.9-6 6.9H2.2l7.8-8.9L1.6 1.2h6.9l4.8 6.3 5.6-6.3zm-1.2 17.6h1.8L7.1 3.1H5.1l12.6 15.7z"/></svg>}
                {s.icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1zm0 2.4c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.2.8-.4.4-.6.7-.8 1.2-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2.4.4.7.6 1.2.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8.4-.4.6-.7.8-1.2.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2-.4-.4-.7-.6-1.2-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 4.1a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6zm0 8.7a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8zm6.6-8.9a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>}
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="logo-word" style="color:#fff; font-size:22px;">Prim<span class="dot">.net</span></span>
            <p>Magazine d'actualités — news France et monde, économie, société, high-tech et conseils pratiques. L'actualités au quotidien, en 12 langues.</p>
          </div>
          <div class="footer-col">
            <h3>Rubriques</h3>
            {topCats.slice(0, 8).map((c) => (
              <a href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
            ))}
          </div>
          <div class="footer-col">
            <h3>Le site</h3>
            <a href="/">Accueil</a>
            <a href="/contact/">Contact</a>
            <a href="/plan-du-site/">Plan du site</a>
          </div>
          <div class="footer-col">
            <h3>Informations</h3>
            <a href="/mentions-legales/">Mentions légales</a>
            <a href="/confidentialite/">Politique de confidentialité</a>
            <a href="/cgv/">Conditions générales de vente</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Prim.net — L'actualités au quotidien en PRIM</p>
        </div>
      </div>
    </footer>

    {
      GA4_ID && (
        <>
          <div id="consent-banner" role="dialog" aria-label="Consentement aux cookies de mesure" hidden>
            <p class="consent-text">
              Nous utilisons des cookies de mesure d'audience (Google Analytics&nbsp;4) pour améliorer ce site.
              Vous pouvez les accepter ou les refuser — <a href="/confidentialite/">en savoir plus</a>.
            </p>
            <div class="consent-actions">
              <button type="button" id="consent-accept">Accepter</button>
              <button type="button" id="consent-refuse" class="consent-refuse">Refuser</button>
            </div>
          </div>
          <script is:inline>
            (function () {
              var KEY = 'prim_consent_v1';
              var banner = document.getElementById('consent-banner');
              if (!banner) return;
              var update = function (v) {
                if (window.gtag) {
                  gtag('consent', 'update', {
                    ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v,
                  });
                }
              };
              var st = null;
              try { st = localStorage.getItem(KEY); } catch (e) {}
              if (st === 'granted') { update('granted'); return; }
              if (st === 'denied') { update('denied'); return; }
              banner.hidden = false;
              document.getElementById('consent-accept').addEventListener('click', function () {
                try { localStorage.setItem(KEY, 'granted'); } catch (e) {}
                update('granted'); banner.hidden = true;
              });
              document.getElementById('consent-refuse').addEventListener('click', function () {
                try { localStorage.setItem(KEY, 'denied'); } catch (e) {}
                update('denied'); banner.hidden = true;
              });
            })();
          </script>
        </>
      )
    }

    <script>
      // Menu burger mobile
      const navToggle = document.querySelector('.nav-toggle');
      const navMenu = document.getElementById('nav-menu');
      if (navToggle && navMenu) {
        const close = () => {
          navMenu.classList.remove('is-open');
          navToggle.setAttribute('aria-expanded', 'false');
        };
        navToggle.addEventListener('click', () => {
          const open = navMenu.classList.toggle('is-open');
          navToggle.setAttribute('aria-expanded', String(open));
        });
        navMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      }

      // Menu déroulant « Rubriques »
      const navDrop = document.querySelector('.nav-drop');
      const navDropBtn = document.querySelector('.nav-drop-btn');
      if (navDrop && navDropBtn) {
        const setDrop = (open) => {
          navDrop.classList.toggle('is-open', open);
          navDropBtn.setAttribute('aria-expanded', String(open));
        };
        navDropBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          setDrop(!navDrop.classList.contains('is-open'));
        });
        document.addEventListener('click', (e) => { if (!navDrop.contains(e.target)) setDrop(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setDrop(false); });
      }

      // Recherche : révéler la barre
      const searchToggle = document.getElementById('search-toggle');
      const searchBar = document.getElementById('search-bar');
      if (searchToggle && searchBar) {
        searchToggle.addEventListener('click', () => {
          const open = searchBar.classList.toggle('is-open');
          searchToggle.setAttribute('aria-expanded', String(open));
          if (open) document.getElementById('search-input').focus();
        });
      }

      // Sélecteur de langue : filtre les cartes marquées [data-lang]
      // (filtrage côté client — le contenu HTML complet reste indexé pour le SEO)
      const langSelect = document.getElementById('lang-select');
      const LANG_KEY = 'prim_lang_v1';
      const applyLangFilter = (code) => {
        const items = document.querySelectorAll('[data-lang]');
        items.forEach((el) => {
          const lang = el.getAttribute('data-lang');
          el.hidden = code !== 'all' && lang !== code;
        });
        // Masquer les sections devenues vides
        document.querySelectorAll('[data-lang-group]').forEach((sec) => {
          const visible = sec.querySelectorAll('[data-lang]:not([hidden])').length > 0;
          sec.hidden = !visible;
        });
      };
      const initLang = () => {
        let code = 'all';
        try {
          const q = new URLSearchParams(window.location.search).get('lang');
          code = q || localStorage.getItem(LANG_KEY) || 'all';
        } catch (e) {}
        if (langSelect) langSelect.value = code;
        applyLangFilter(code);
      };
      if (langSelect) {
        langSelect.addEventListener('change', () => {
          try { localStorage.setItem(LANG_KEY, langSelect.value); } catch (e) {}
          applyLangFilter(langSelect.value);
        });
      }
      initLang();
    </script>
  </body>
</html>
