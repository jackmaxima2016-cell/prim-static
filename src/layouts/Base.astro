---
// Layout de base — head SEO complet (title, description, canonical, og, JSON-LD)
// Design Newsmag Scandal : topbar date + social + langue + recherche,
// logo centré (image d'origine), navigation sticky, footer optimisé.
import { decodeEntities, getCategories } from '../lib/wp.mjs';
import LanguageSelect from '../components/LanguageSelect.astro';
import LanguageFlags from '../components/LanguageFlags.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
  relPrev?: string;
  relNext?: string;
  preloadImage?: string;
  /** Langue de la page (<html lang>) — défaut 'fr' */
  lang?: string;
  /** Force la langue du filtre client (pages d'accueil par langue, sans data-lang) */
  fixedLang?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  type = 'website',
  relPrev,
  relNext,
  preloadImage,
  lang = 'fr',
  fixedLang,
} = Astro.props;

// Préversion : NOINDEX=1 au build => toutes les pages en noindex
const noindexAll = typeof process !== 'undefined' && process.env.NOINDEX === '1';

const GA4_ID = (import.meta.env.PUBLIC_GA4_ID ?? '').trim();

const site = String(Astro.site ?? 'https://prim.net').replace(/\/$/, '');
const pageUrl = canonical ?? site + '/';
const ogType = type === 'article' ? 'article' : 'website';

// Rubriques de la navigation : 20 catégories les plus fournies
const topCats = getCategories()
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 20);

const today = new Date().toLocaleDateString('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/prim-logo-square.png" />
    <title>{decodeEntities(title)}</title>
    {description && <meta name="description" content={decodeEntities(description)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noindexAll && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />
    {relPrev && <link rel="prev" href={relPrev} />}
    {relNext && <link rel="next" href={relNext} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Prim.net" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={decodeEntities(title)} />
    {description && <meta property="og:description" content={decodeEntities(description)} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="sitemap" href={site + '/sitemap-index.xml'} />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    {/* Google Analytics 4 — actif uniquement si PUBLIC_GA4_ID est défini au build */}
    {
      GA4_ID && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
          <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('consent', 'default', {
  ad_storage: 'denied', ad_user_data: 'denied',
  ad_personalization: 'denied', analytics_storage: 'denied',
});
gtag('config', '${GA4_ID}', { anonymize_ip: true });`}></script>
        </>
      )
    }

    {/* Contenu head supplémentaire (hreflang des accueils par langue) */}
    <slot name="head" />

    {/* Anti-CLS : filtre de langue appliqué pendant le parsing (avant le premier paint).
        Sans ce script, le JS de fin de page masque les articles/sections hors langue APRÈS le
        rendu → tout le contenu remonte → CLS ≈ 0,67 sur mobile. Ici chaque [data-lang] est masqué
        dès son insertion dans le DOM ; le script principal (fin de body) reste l'unique source des
        changements interactifs (drapeaux, recherche) et ré-applique le même état (idempotent). */}
    <script is:inline>
      (function () {
        var FLAGS = ['fr','en','es','de','it','pl','ar','nl','pt','tr','nn','ru'];
        var key = 'prim_lang_v1';
        var lang = 'fr';
        try {
          var p = new URLSearchParams(location.search);
          var s = null;
          try { s = localStorage.getItem(key); } catch (e) {}
          var nav = (navigator.languages && navigator.languages.length) ? navigator.languages : (navigator.language ? [navigator.language] : []);
          var aliases = { no: 'nn', nb: 'nn' };
          var det = null;
          for (var i = 0; i < nav.length; i++) {
            var b = String(nav[i]).toLowerCase().split('-')[0];
            var c = aliases[b] || b;
            if (FLAGS.indexOf(c) !== -1) { det = c; break; }
          }
          lang = p.get('lang') || s || det || 'fr';
        } catch (e) {}
        var hideEl = function (el) { el.hidden = !(lang === 'all' || el.getAttribute('data-lang') === lang); };
        var refreshSection = function (el) {
          var sec = el;
          while (sec && sec !== document.documentElement && !(sec.nodeType === 1 && sec.hasAttribute('data-lang-group'))) sec = sec.parentNode;
          if (sec && sec.nodeType === 1 && sec.hasAttribute('data-lang-group')) {
            sec.hidden = !sec.querySelector('[data-lang]:not([hidden])');
          }
        };
        var onAdded = function (n) {
          if (!n || n.nodeType !== 1) return;
          if (n.hasAttribute('data-lang')) hideEl(n);
          var items = n.querySelectorAll ? n.querySelectorAll('[data-lang]') : [];
          for (var j = 0; j < items.length; j++) hideEl(items[j]);
          refreshSection(n);
        };
        if (document.readyState === 'loading') {
          new MutationObserver(function (muts) {
            for (var i = 0; i < muts.length; i++) {
              var nodes = muts[i].addedNodes;
              for (var j = 0; j < nodes.length; j++) onAdded(nodes[j]);
            }
          }).observe(document.documentElement, { childList: true, subtree: true });
        } else {
          var all = document.querySelectorAll('[data-lang]');
          for (var k = 0; k < all.length; k++) hideEl(all[k]);
          var grp = document.querySelectorAll('[data-lang-group]');
          for (var g = 0; g < grp.length; g++) refreshSection(grp[g]);
        }
      })();
    </script>
  </head>
  <body data-fixed-lang={fixedLang || undefined}>
    <!-- Bandeau supérieur : date + tagline -->
    <div class="topbar">
      <div class="container topbar-inner">
        <span class="topbar-date">{today}</span>
        <span class="topbar-tagline">L'actualités au quotidien en PRIM</span>
      </div>
    </div>

    <!-- En-tête : logo d'origine centré -->
    <header class="site-header">
      <div class="header-brand">
        <div class="container header-brand-inner">
          <a class="logo" href="/">
            <img class="logo-img" src="/prim-logo.png" alt="Prim.net" width="203" height="75" fetchpriority="low" />
          </a>
          <p class="header-tagline">L'actualités au quotidien en PRIM</p>
        </div>
      </div>
    </header>

    <!-- Barre de contrôle : recherche (gauche) | menu (milieu) | langue (droite) -->
    <nav class="header-nav" id="header-nav" aria-label="Navigation">
      <div class="container nav-bar">
        <button class="icon-btn nav-search-btn" id="search-toggle" type="button" aria-expanded="false" aria-controls="search-panel" aria-label="Rechercher">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 2a8 8 0 1 0 4.9 14.3L20 21l1-1-5-5.1A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"/></svg>
        </button>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label="Ouvrir le menu">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>

        <div class="nav-right">
          <a class="btn-publier nav-publier" href="/publier-un-article/">Être publié →</a>
          <button class="icon-btn nav-lang-btn" id="lang-toggle" type="button" aria-expanded="false" aria-controls="lang-panel" aria-label="Choisir la langue">
            <span class="lang-current-flag" id="lang-current-flag" aria-hidden="true">🌐</span>
          </button>
        </div>
      </div>

      <!-- Panneau recherche -->
      <div class="nav-panel" id="search-panel" hidden>
        <div class="container">
          <form class="search-form" action="/" method="get" role="search">
            <input type="search" name="s" id="search-input" placeholder="Rechercher…" aria-label="Rechercher" />
            <button type="submit" aria-label="Rechercher">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 2a8 8 0 1 0 4.9 14.3L20 21l1-1-5-5.1A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"/></svg>
            </button>
          </form>
        </div>
      </div>

      <!-- Panneau langue (drapeaux) -->
      <div class="nav-panel lang-panel" id="lang-panel" hidden>
        <div class="container lang-panel-inner">
          <LanguageFlags />
        </div>
      </div>

      <!-- Menu -->
      <div class="nav-panel menu-panel" id="menu-panel" hidden>
        <div class="container nav-inner">
          <a href="/">Accueil</a>
          <a href="/publier-un-article/">Être publié</a>
          <a href="/contact/">Contact</a>
          <div class="nav-drop">
            <button class="nav-drop-btn" type="button" aria-expanded="false" aria-haspopup="true">
              Rubriques <span class="nav-drop-caret" aria-hidden="true">▾</span>
            </button>
            <div class="nav-drop-menu" role="menu">
              {topCats.map((c) => (
                <a role="menuitem" href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="footer-logo" href="/">
              <img class="logo-img footer-logo-img" src="/prim-logo-square.png" alt="Prim.net" width="44" height="44" loading="lazy" />
              <span class="logo-word">Prim<span class="dot">.</span>net</span>
            </a>
            <p>Magazine d'actualités — news France et monde, économie, société, high-tech et conseils pratiques. L'actualités au quotidien, en 12 langues.</p>
            <div class="footer-social">
              <a class="social-facebook" href="https://www.facebook.com/PrimNetFr" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 9H16l.5-3h-3V4.5c0-.9.3-1.5 1.6-1.5H16.6V.2C16.3.2 15.3 0 14.1 0 11.6 0 10 1.5 10 4.2V6H7.5v3H10v11h3.5V9z"/></svg>
              </a>
              <a class="social-x" href="https://twitter.com/Prim_fr" target="_blank" rel="noopener" aria-label="X (Twitter)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.2h3.3l-7.3 8.3 8.6 11.3h-6.7l-5.3-6.9-6 6.9H2.2l7.8-8.9L1.6 1.2h6.9l4.8 6.3 5.6-6.3zm-1.2 17.6h1.8L7.1 3.1H5.1l12.6 15.7z"/></svg>
              </a>
              <a class="social-instagram" href="https://instagram.com/prim_france" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1zm0 2.4c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.2.8-.4.4-.6.7-.8 1.2-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2.4.4.7.6 1.2.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8.4-.4.6-.7.8-1.2.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2-.4-.4-.7-.6-1.2-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 4.1a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6zm0 8.7a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8zm6.6-8.9a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>
              </a>
            </div>
          </div>
          <div class="footer-col">
            <h3>Rubriques</h3>
            {topCats.slice(0, 8).map((c) => (
              <a href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
            ))}
          </div>
          <div class="footer-col">
            <h3>Le site</h3>
            <a href="/">Accueil</a>
            <a href="/publier-un-article/">Être publié</a>
            <a href="/contact/">Contact</a>
            <a href="/plan-du-site/">Plan du site</a>
          </div>
          <div class="footer-col">
            <h3>Informations</h3>
            <a href="/mentions-legales/">Mentions légales</a>
            <a href="/confidentialite/">Politique de confidentialité</a>
            <a href="/cgv/">Conditions générales de vente</a>
          </div>
        </div>
        <div class="footer-bottom">
          <div class="footer-bottom-lang">
            <LanguageSelect id="lang-select-footer" />
          </div>
          <p>© {new Date().getFullYear()} Prim.net — L'actualités au quotidien en PRIM</p>
        </div>
      </div>
    </footer>

    <!-- Bouton retour en haut -->
    <button class="back-to-top" id="back-to-top" type="button" aria-label="Retour en haut">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4l-7 7 1.4 1.4L11 7.8V20h2V7.8l4.6 4.6L19 11z"/></svg>
    </button>

    {
      GA4_ID && (
        <>
          <div id="consent-banner" role="dialog" aria-label="Consentement aux cookies de mesure" hidden>
            <p class="consent-text">
              Nous utilisons des cookies de mesure d'audience (Google Analytics&nbsp;4) pour améliorer ce site.
              Vous pouvez les accepter ou les refuser — <a href="/confidentialite/">en savoir plus</a>.
            </p>
            <div class="consent-actions">
              <button type="button" id="consent-accept">Accepter</button>
              <button type="button" id="consent-refuse" class="consent-refuse">Refuser</button>
            </div>
          </div>
          <script is:inline>
            (function () {
              var KEY = 'prim_consent_v1';
              var banner = document.getElementById('consent-banner');
              if (!banner) return;
              var update = function (v) {
                if (window.gtag) {
                  gtag('consent', 'update', {
                    ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v,
                  });
                }
              };
              var st = null;
              try { st = localStorage.getItem(KEY); } catch (e) {}
              if (st === 'granted') { update('granted'); return; }
              if (st === 'denied') { update('denied'); return; }
              banner.hidden = false;
              document.getElementById('consent-accept').addEventListener('click', function () {
                try { localStorage.setItem(KEY, 'granted'); } catch (e) {}
                update('granted'); banner.hidden = true;
              });
              document.getElementById('consent-refuse').addEventListener('click', function () {
                try { localStorage.setItem(KEY, 'denied'); } catch (e) {}
                update('denied'); banner.hidden = true;
              });
            })();
          </script>
        </>
      )
    }

    <script>
      // Barre de contrôle : trois boutons → trois panneaux (un seul ouvert à la fois)
      const headerNav = document.getElementById('header-nav');
      const panels = {
        search: { btn: document.getElementById('search-toggle'), panel: document.getElementById('search-panel') },
        menu:   { btn: document.querySelector('.nav-toggle'), panel: document.getElementById('menu-panel') },
        lang:   { btn: document.getElementById('lang-toggle'), panel: document.getElementById('lang-panel') },
      };
      const closePanels = () => {
        Object.values(panels).forEach(({ btn, panel }) => {
          if (btn) btn.setAttribute('aria-expanded', 'false');
          if (panel) panel.hidden = true;
        });
      };
      const openPanel = (key) => {
        const { btn, panel } = panels[key];
        if (!btn || !panel) return;
        const willOpen = panel.hidden;
        closePanels();
        if (willOpen) {
          panel.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
        }
      };
      Object.entries(panels).forEach(([key, { btn }]) => {
        if (btn) btn.addEventListener('click', () => openPanel(key));
      });
      document.addEventListener('click', (e) => {
        if (headerNav && !headerNav.contains(e.target)) closePanels();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanels(); });
      // Fermer le menu quand on clique un lien du panneau menu
      const menuPanel = panels.menu.panel;
      if (menuPanel) {
        menuPanel.querySelectorAll('a').forEach((a) => a.addEventListener('click', closePanels));
      }

      // Sous-menu « Rubriques »
      const navDrop = document.querySelector('.nav-drop');
      const navDropBtn = document.querySelector('.nav-drop-btn');
      if (navDrop && navDropBtn) {
        const setDrop = (open) => {
          navDrop.classList.toggle('is-open', open);
          navDropBtn.setAttribute('aria-expanded', String(open));
        };
        navDropBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          setDrop(!navDrop.classList.contains('is-open'));
        });
      }

      // Sélecteur de langue (drapeaux + select) + recherche client.
      // Filtre les cartes marquées [data-lang] / [data-title] — le HTML complet reste indexé (SEO).
      const langFlags = document.querySelectorAll('.lang-flag');
      const langSelects = document.querySelectorAll('.lang-select');
      const langCurrentFlag = document.getElementById('lang-current-flag');
      const LANG_KEY = 'prim_lang_v1';
      const LANG_FLAGS = { fr: '🇫🇷', en: '🇬🇧', es: '🇪🇸', de: '🇩🇪', it: '🇮🇹', pl: '🇵🇱', ar: '🇸🇦', nl: '🇳🇱', pt: '🇵🇹', tr: '🇹🇷', nn: '🇳🇴', ru: '🇷🇺', all: '🌐' };
      let currentLang = 'fr';
      let currentQuery = '';

      // Détecte la langue du navigateur et la ramène à un code supporté.
      const detectBrowserLang = () => {
        try {
          const langs = (navigator.languages && navigator.languages.length)
            ? navigator.languages
            : (navigator.language ? [navigator.language] : []);
          const aliases = { 'no': 'nn', 'nb': 'nn' }; // norvégien
          for (const raw of langs) {
            const base = String(raw || '').toLowerCase().split('-')[0];
            const code = aliases[base] || base;
            if (Object.prototype.hasOwnProperty.call(LANG_FLAGS, code) && code !== 'all') return code;
          }
        } catch (e) {}
        return 'fr';
      };

      const applyFilters = () => {
        const items = document.querySelectorAll('[data-lang]');
        const q = currentQuery.trim().toLowerCase();
        items.forEach((el) => {
          const lang = el.getAttribute('data-lang');
          const byLang = currentLang === 'all' || lang === currentLang;
          let byQuery = true;
          if (q) {
            const title = (el.getAttribute('data-title') || '').toLowerCase();
            byQuery = title.includes(q);
          }
          el.hidden = !(byLang && byQuery);
        });
        // Masquer les sections devenues vides
        document.querySelectorAll('[data-lang-group]').forEach((sec) => {
          const visible = sec.querySelectorAll('[data-lang]:not([hidden])').length > 0;
          sec.hidden = !visible;
        });
        // État actif des drapeaux
        langFlags.forEach((b) => {
          const active = b.getAttribute('data-lang') === currentLang;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
      };
      const setLang = (code) => {
        currentLang = code;
        try { localStorage.setItem(LANG_KEY, code); } catch (e) {}
        langSelects.forEach((s) => { s.value = code; });
        if (langCurrentFlag) langCurrentFlag.textContent = LANG_FLAGS[code] || '🌐';
        applyFilters();
      };
      const initFilters = () => {
        let code = 'fr';
        try {
          const params = new URLSearchParams(window.location.search);
          // Priorité : langue fixée par la page (accueils /<lang>/) > ?lang= explicite
          // > préférence stockée > langue du navigateur
          const fixed = document.body && document.body.getAttribute('data-fixed-lang');
          code = fixed || params.get('lang') || localStorage.getItem(LANG_KEY) || detectBrowserLang() || 'fr';
          currentQuery = params.get('s') || '';
          const input = document.getElementById('search-input');
          if (input && currentQuery) input.value = currentQuery;
        } catch (e) {}
        setLang(code);
      };
      langFlags.forEach((b) => {
        b.addEventListener('click', () => {
          setLang(b.getAttribute('data-lang'));
          closePanels();
        });
      });
      langSelects.forEach((sel) => {
        sel.addEventListener('change', () => setLang(sel.value));
      });
      // Recherche en temps réel (filtre les cartes à la saisie)
      const searchInput = document.getElementById('search-input');
      if (searchInput) {
        searchInput.addEventListener('input', () => {
          currentQuery = searchInput.value;
          applyFilters();
        });
      }
      initFilters();

      // Bouton retour en haut : apparaît après 400 px de scroll
      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        const onScroll = () => {
          backToTop.classList.toggle('is-visible', window.scrollY > 400);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
